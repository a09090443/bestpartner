# =============================================================================
# BestPartner 環境變數範本（master template）
# -----------------------------------------------------------------------------
# 用法：
#   本機開發   cp .env.example .env           （Quarkus quarkusDev 會自動載入 .env）
#   其他環境   cp .env.example .env.<profile>  並填入該環境的值
#              <profile> = docker / sit / uat / prod
#
# 容器執行：
#   docker run -d -p 80:80 -e QUARKUS_PROFILE=uat --env-file .env.uat bestpartner-service:latest
#
# ⚠️ 格式限制：本檔會被 `docker --env-file` 讀取，它不做 shell 引號處理。
#    值一律「不加引號」，且不支援 ${VAR} 巢狀展開。
#
# ⚠️ .env 與 .env.<profile> 皆已列入 .gitignore，不會提交；只有本範本進版控。
#
# 每個鍵對應 application.properties 的 ${ENV_VAR:預設值}；
# 未設定時即採用該預設值（＝本機 Windows 開發值）。
# =============================================================================

# --- HTTP ---------------------------------------------------------------
# 服務埠。容器內建議維持 80，對外埠用 docker -p 對映
HTTP_PORT=80

# --- 資料庫 -------------------------------------------------------------
# ⚠️ 容器內不可用 localhost（那會指向容器自己）。
#    連本機 DB 用 host.docker.internal；連 compose 內的 DB 用服務名。
DB_URL=jdbc:postgresql://localhost:5432/pgdb?currentSchema=bestpartner
DB_USERNAME=pguser
DB_PASSWORD=pgpass
DB_POOL_MIN=5
DB_POOL_MAX=15

# --- 路徑 ---------------------------------------------------------------
# ⚠️ 預設值為 Windows 路徑（D:/tmp/bestpartner），容器/Linux 務必覆寫為 POSIX 路徑，
#    否則會在容器內產生名為 "D:" 的字面目錄。
#    容器內建議搭配 docker -v 掛載，否則檔案隨容器刪除而消失。
LOG_DIR=D:/tmp/bestpartner
FILE_UPLOAD_DIR=D:/tmp/bestpartner/upload

# --- 安全 ---------------------------------------------------------------
# 「資料庫敏感欄位」AES-GCM 加密金鑰。
# ⚠️ sit 以上環境務必替換為高強度隨機字串，且各環境不同。
#    變更此值會使既有加密資料（如 llm_setting.api_key）無法解密。
CRYPTO_SECRET_KEY=changeme-please-replace-in-production

# 「設定檔機密值」解密的根金鑰（CONFIG_ENCRYPTION_KEY）
#
# ⚠️ 刻意「不」寫在本檔或任何 .env.<profile> 中。
#    本檔內的機密以 ${enc::<密文>} 存放，若解密金鑰就放在同一個檔案，
#    等於鎖和鑰匙放同一個信封——拿到檔案即可解密，加密形同虛設。
#
# 實際存放位置：.secrets/config-encryption-key.<profile>（已列入 .gitignore）
# 部署時單獨注入，不經由 --env-file：
#
#   docker run -d -p 80:80 \
#     -e QUARKUS_PROFILE=sit \
#     -e CONFIG_ENCRYPTION_KEY="$(cat .secrets/config-encryption-key.sit)" \
#     --env-file .env.sit \
#     bestpartner-service:latest
#
# 未注入金鑰而設定值為密文時，啟動會以 AEADBadTagException（Tag mismatch）明確失敗，
# 不會靜默把密文當成密碼使用。

# --- 機密值加密用法 -----------------------------------------------------
# 本檔以下的機密（DB_PASSWORD、OPENROUTER_API_KEY 等）在 sit 以上環境
# 應改寫為密文，啟動時由 SmallRye Config 自動解密：
#
#   1. 產生密文（金鑰與明文走環境變數，不進命令列參數與 shell 歷史紀錄）：
#        $env:CONFIG_ENCRYPTION_KEY=(Get-Content .secrets/config-encryption-key.sit -Raw).Trim()
#        $env:CONFIG_SECRET_VALUE='<機密明文>'
#        cd bestpartner-service; ./gradlew encryptConfigSecret -q
#
#   2. 將輸出填入本檔，格式為 ${enc::<密文>}：
#        DB_PASSWORD=${enc::<密文>}
#
# ⚠️ 值一律不加引號（docker --env-file 不做引號處理），密文為 URL-safe Base64，
#    不含空白或引號，可直接貼上。
# ⚠️ 明文與密文可混用：未加密的值維持原樣即可，機制只對 ${enc::...} 生效。
# ⚠️ 本機開發不需加密——以下預設值皆為非機密的開發值。

# JWT 自動刷新開關
JWT_REFRESH_SWITCH=true

# --- AI 平台金鑰 --------------------------------------------------------
# ADMIN CHAT（/llm/admin/chat）的系統預設模型。
# 留空時服務仍可正常啟動，但呼叫 ADMIN CHAT 會得到 OpenRouter 401。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.5-pro
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_TOP_P=0.5
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TIMEOUT=60s

# 供使用者自建 LLM 設定時參考（application.properties 未直接引用）
OPENAI_API_KEY=
